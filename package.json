{
  "name": "nativa-prototipo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Protótipo local do RPG NATIVA",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^3.0.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "lucide": "^1.70.0",
    "ua-parser-js": "^2.0.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"scripts/**/*.{js,mjs,json}\" \"tests/**/*.js\"",
    "assets": "node scripts/generate-assets.mjs",
    "assets:optimize": "node scripts/optimize-portraits.mjs",
    "assets:arena": "node scripts/optimize-arena-art.mjs",
    "catalog:inventory": "node scripts/export-catalog-inventory.mjs",
    "test:online:local": "node tests/online-arena.local.integration.mjs",
    "combat:sync": "node scripts/sync-combat-server.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
